# Static file server for the PrintDesk bundle.
{
	admin off
	# Railway terminates TLS at its edge and forwards plain HTTP, so Caddy must
	# not try to obtain its own certificate.
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# Deliberately NO Cross-Origin-Opener-Policy / Cross-Origin-Embedder-Policy.
	# Those headers are only needed by sqlite-wasm's SharedArrayBuffer-based
	# `opfs` VFS. This app uses `opfs-sahpool`, which needs neither, and setting
	# them would break the Google Fonts stylesheets loaded from index.css.
	header {
		# Hide the server fingerprint.
		-Server
		# Clickjacking / MIME-sniffing basics for a page that renders business data.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Vite fingerprints asset filenames, so they are safe to cache permanently.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# index.html must not be cached, or a deploy would leave browsers pinned to
	# the previous bundle and its now-missing asset hashes.
	@html path / /index.html
	header @html Cache-Control "no-cache, must-revalidate"

	# Correct type for the SQLite engine. Caddy's bundled mime types already
	# cover .wasm, but this makes the requirement explicit: browsers refuse to
	# instantiate a WASM module served as application/octet-stream.
	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	# Single-page app with no router today, but a stray path should still land on
	# the app rather than a bare 404.
	try_files {path} /index.html
	file_server
}
